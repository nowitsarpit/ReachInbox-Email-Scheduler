# GoMAil Environment Configuration
# Copy this file to .env and fill in the values

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://gomail:gomail@localhost:5432/gomail

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Ethereal SMTP (test email provider) ────────────────────
# Auto-created on first run if not provided. Visit https://ethereal.email
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_FROM_NAME=GoMAil
ETHEREAL_FROM_EMAIL=

# ─── Worker Configuration ────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_QUEUE_NAME=gomail:delivery
OUTBOX_POLL_INTERVAL_MS=1000
LEASE_TIMEOUT_MS=60000

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_HOUR=500
RATE_LIMIT_ORG_PER_HOUR=200
RATE_LIMIT_SENDER_PER_HOUR=100

# ─── Google OAuth (REQUIRED — create at console.cloud.google.com) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ─── Session ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=
SESSION_DURATION_DAYS=30

# ─── App URLs ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Allowed CORS Origins ───────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Webhook ────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
