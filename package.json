{
  "name": "gomail",
  "version": "1.0.0",
  "private": true,
  "description": "GoMAil — Plan. Deliver. Observe.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run worker -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:worker": "npm run worker -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm test -w backend && npm test -w frontend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:push": "npm run db:push -w backend",
    "db:studio": "npm run db:studio -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
